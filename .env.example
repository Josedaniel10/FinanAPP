# FinanAPP - Variables de Entorno

# Puerto del servidor
PORT=3000

# Secreto para firma de tokens JWT
JWT_SECRET="finanapp_production_secret_key_2026_jwt"
JWT_EXPIRES_IN="7d"

# MongoDB Atlas URI (MongoDB oficial en la nube)
# Reemplaza con tu cadena de conexión copiada desde MongoDB Atlas (mongodb.com):
MONGODB_URI="mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/finanapp?retryWrites=true&w=majority"
MONGODB_DB_NAME="finanapp"

# API Key de Google Gemini (Opcional, para transcripción de voz multimodal avanzada)
GEMINI_API_KEY=""
