# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET="your_jwt_super_secret_key_change_in_production"

# PORT: Port where Express dev server runs
PORT=3000

# MONGODB_URI: Connection string for MongoDB (e.g. mongodb://localhost:27017/finanapp or MongoDB Atlas URI)
# If not provided, an embedded MongoMemoryServer instance is automatically started for local dev
MONGODB_URI="mongodb://localhost:27017/finanapp"
MONGODB_DB_NAME="finanapp"
